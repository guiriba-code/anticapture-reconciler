# Copy to .env and edit. Every variable is optional: the defaults below are public
# endpoints that need no key. Never commit a real .env file.

# Anticapture public API (Gateful).
ANTICAPTURE_API_URL=https://www.anticapture.com/api/gateful

# Source of the indexer address lists. Point ANTICAPTURE_CONSTANTS_PATH at a local
# checkout to test unmerged list changes (it wins over the URL).
ANTICAPTURE_CONSTANTS_URL=https://raw.githubusercontent.com/blockful/anticapture/dev/apps/indexer/src/lib/constants.ts
# ANTICAPTURE_CONSTANTS_PATH=/path/to/anticapture/apps/indexer/src/lib/constants.ts

# Ethereum mainnet JSON-RPC, comma-separated, tried in order. Must support
# eth_call and eth_getLogs over ~15k-block ranges. A private RPC URL that embeds a key
# belongs only in your local .env or a CI secret, never in git.
RPC_URL=https://rpc.mevblocker.io,https://eth.drpc.org,https://eth-mainnet.public.blastapi.io

# Scroll JSON-RPC (for SCR), comma-separated.
SCROLL_RPC_URL=https://rpc.scroll.io,https://scroll.drpc.org

# Ethplorer API for the top-holders check. "freekey" is Ethplorer's public demo key.
ETHPLORER_API_URL=https://api.ethplorer.io
ETHPLORER_API_KEY=freekey

# Minimum seconds between Anticapture API requests, and HTTP timeout.
API_MIN_INTERVAL_SECONDS=0.6
HTTP_TIMEOUT_SECONDS=60
